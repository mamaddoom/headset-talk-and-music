<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: name + live status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pages -->
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ============================== INTERCOM ============================== -->
            <ScrollView android:id="@+id/pageHome" style="@style/Page">

                <LinearLayout android:id="@+id/homeColumn" style="@style/PageColumn">

                    <Button
                        android:id="@+id/btnStart"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/button_start"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/start"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <!-- Talk circle with its label on top -->
                    <FrameLayout
                        android:id="@+id/talkArea"
                        android:layout_width="match_parent"
                        android:layout_height="270dp"
                        android:layout_marginTop="8dp">

                        <com.mamaddoom.ridetalk.ui.TalkButtonView
                            android:id="@+id/talkButton"
                            android:layout_width="270dp"
                            android:layout_height="270dp"
                            android:layout_gravity="center"
                            android:clickable="true"
                            android:focusable="true" />

                        <LinearLayout
                            android:layout_width="170dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/talkIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎙"
                                android:textSize="40sp" />

                            <TextView
                                android:id="@+id/talkLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:textColor="@color/text"
                                android:textSize="17sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/talkRoleNote"
                        style="@style/Note"
                        android:gravity="center"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/micError"
                        style="@style/Note"
                        android:gravity="center"
                        android:text="@string/mic_unavailable"
                        android:textColor="@color/danger"
                        android:visibility="gone" />

                    <!-- Call-mode controls: open mic / push-to-talk / mute -->
                    <LinearLayout
                        android:id="@+id/callControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button android:id="@+id/btnModeVox" style="@style/BigButton" android:text="@string/mode_vox" />
                        <Button android:id="@+id/btnModePtt" style="@style/BigButton" android:text="@string/mode_ptt" />
                    </LinearLayout>

                    <!-- Riders -->
                    <LinearLayout style="@style/Card">

                        <TextView style="@style/CardTitle" android:text="@string/sec_peers" />

                        <LinearLayout
                            android:id="@+id/peerList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:animateLayoutChanges="true"
                            android:orientation="vertical" />

                        <TextView android:id="@+id/noPeers" style="@style/Note" android:text="@string/no_peers" />
                    </LinearLayout>

                    <!-- Link -->
                    <LinearLayout style="@style/Card">

                        <TextView style="@style/CardTitle" android:text="@string/sec_link" />

                        <TextView android:id="@+id/linkQuality" style="@style/Body" android:fontFamily="sans-serif-medium" android:textSize="15sp" />
                        <TextView android:id="@+id/route" style="@style/Note" />
                        <TextView android:id="@+id/myIp" style="@style/Note" />
                        <TextView android:id="@+id/wifiInfo" style="@style/Note" android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <Button android:id="@+id/btnVolume" style="@style/BigButton" android:text="@string/volume_button" android:textSize="15sp" />
                            <Button android:id="@+id/btnDrive" style="@style/BigButton" android:text="@string/drive_mode" android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ============================== MUSIC ============================== -->
            <ScrollView android:id="@+id/pageMusic" style="@style/Page" android:visibility="gone">

                <LinearLayout android:id="@+id/musicColumn" style="@style/PageColumn">

                    <TextView
                        android:id="@+id/musicRoleNote"
                        style="@style/Note"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/music_on_music_phone"
                        android:visibility="gone" />

                    <LinearLayout android:id="@+id/musicCard" style="@style/Card" android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/musicTitle"
                            style="@style/Body"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textSize="19sp" />

                        <TextView android:id="@+id/musicInfo" style="@style/Note" android:gravity="center" />

                        <!-- Source -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <Button android:id="@+id/btnSrcFiles" style="@style/BigButton" android:layout_height="48dp" android:text="@string/src_files" android:textSize="15sp" />
                            <Button android:id="@+id/btnSrcApp" style="@style/BigButton" android:layout_height="48dp" android:text="@string/src_app" android:textSize="15sp" />
                        </LinearLayout>

                        <!-- Playlist -->
                        <LinearLayout
                            android:id="@+id/panelFiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:animateLayoutChanges="true"
                            android:orientation="vertical">

                            <SeekBar android:id="@+id/seekPos" style="@style/Slider" android:layout_marginTop="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layoutDirection="ltr">

                                <TextView android:id="@+id/tvPos" style="@style/Note" android:layout_width="0dp" android:layout_weight="1" />
                                <TextView android:id="@+id/tvDur" style="@style/Note" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:layoutDirection="ltr">

                                <Button android:id="@+id/btnPrev" style="@style/BigButton" android:layout_width="64dp" android:layout_height="64dp" android:layout_weight="0" android:text="@string/prev" android:textSize="22sp" />

                                <Button
                                    android:id="@+id/btnPlay"
                                    android:layout_width="88dp"
                                    android:layout_height="88dp"
                                    android:layout_marginStart="18dp"
                                    android:layout_marginEnd="18dp"
                                    android:background="@drawable/play_circle"
                                    android:stateListAnimator="@null"
                                    android:text="@string/play"
                                    android:textColor="@color/bg"
                                    android:textSize="30sp" />

                                <Button android:id="@+id/btnNext" style="@style/BigButton" android:layout_width="64dp" android:layout_height="64dp" android:layout_weight="0" android:text="@string/next" android:textSize="22sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp">

                                <Button android:id="@+id/btnAddMusic" style="@style/BigButton" android:text="@string/add_music" android:textSize="15sp" />
                                <Button android:id="@+id/btnShuffle" style="@style/BigButton" android:text="@string/shuffle" android:textSize="15sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/trackList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:animateLayoutChanges="true"
                                android:orientation="vertical" />

                            <Button
                                android:id="@+id/btnClearList"
                                style="@style/BigButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_weight="0"
                                android:background="@android:color/transparent"
                                android:text="@string/clear_list"
                                android:textColor="@color/text_dim"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Any app -->
                        <LinearLayout
                            android:id="@+id/panelApp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView style="@style/Note" android:layout_marginTop="10dp" android:text="@string/app_audio_note" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">

                                <Button android:id="@+id/btnAppAudio" style="@style/BigButton" android:layout_height="64dp" android:text="@string/app_audio_start" />
                            </LinearLayout>

                            <TextView android:id="@+id/appAudioStatus" style="@style/Body" android:layout_marginTop="4dp" android:gravity="center" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/musicLevels" style="@style/Card">

                        <TextView style="@style/CardTitle" android:text="@string/sec_levels" />

                        <TextView style="@style/Body" android:text="@string/music_volume" />
                        <SeekBar android:id="@+id/seekMusic" style="@style/Slider" android:max="100" />

                        <Switch android:id="@+id/swDuck" style="@style/BigSwitch" android:text="@string/ducking" />

                        <TextView android:id="@+id/syncLabel" style="@style/Label" />
                        <SeekBar android:id="@+id/seekSync" style="@style/Slider" android:max="40" />
                        <TextView style="@style/Note" android:text="@string/sync_note" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ============================== SETTINGS ============================== -->
            <ScrollView android:id="@+id/pageSettings" style="@style/Page" android:visibility="gone">

                <LinearLayout android:id="@+id/settingsColumn" style="@style/PageColumn">

                    <!-- Trip setup -->
                    <LinearLayout style="@style/Card" android:layout_marginTop="4dp">

                        <TextView style="@style/CardTitle" android:text="@string/sec_setup" />
                        <TextView style="@style/Note" android:layout_marginTop="0dp" android:text="@string/setup_intro" />

                        <LinearLayout
                            android:id="@+id/preset1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/preset1_icon" android:textSize="26sp" />

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/preset1_title" android:textColor="@color/text" android:textSize="16sp" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preset1_desc" android:textColor="@color/text_dim" android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/preset2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/preset2_icon" android:textSize="26sp" />

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/preset2_title" android:textColor="@color/text" android:textSize="16sp" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preset2_desc" android:textColor="@color/text_dim" android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/twoPhonePanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView style="@style/Body" android:fontFamily="sans-serif-medium" android:text="@string/two_phone_which" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                                <Button android:id="@+id/btnPhoneMusic" style="@style/BigButton" android:layout_height="84dp" android:text="@string/two_phone_music" android:textSize="15sp" />
                                <Button android:id="@+id/btnPhoneMic" style="@style/BigButton" android:layout_height="84dp" android:text="@string/two_phone_mic" android:textSize="15sp" />
                            </LinearLayout>

                            <TextView style="@style/Note" android:text="@string/two_phone_note" />
                            <EditText android:id="@+id/setupName" style="@style/Field" android:hint="@string/name_hint" android:inputType="textPersonName" android:maxLength="24" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/setupFlow"
                            style="@style/Body"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/pill"
                            android:lineSpacingMultiplier="1.35"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:textSize="14sp" />

                        <TextView android:id="@+id/setupChecklist" style="@style/Body" android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.35" android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Audio -->
                    <LinearLayout android:id="@+id/audioCard" style="@style/Card">

                        <TextView style="@style/CardTitle" android:text="@string/sec_audio" />

                        <LinearLayout android:id="@+id/audioModeRow" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <Button android:id="@+id/btnModeHifi" style="@style/BigButton" android:text="@string/mode_hifi" android:textSize="15sp" />
                            <Button android:id="@+id/btnModeCall" style="@style/BigButton" android:text="@string/mode_call" android:textSize="15sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/modeNote" style="@style/Note" />
                        <TextView android:id="@+id/modeSaved" style="@style/Note" android:text="@string/mode_saved" />

                        <LinearLayout android:id="@+id/micSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                            <TextView android:id="@+id/noiseLabel" style="@style/Label" />
                            <SeekBar android:id="@+id/seekNoise" style="@style/Slider" android:max="100" />
                            <TextView style="@style/Note" android:layout_marginTop="0dp" android:text="@string/noise_note" />

                            <TextView android:id="@+id/voxLabel" style="@style/Label" android:text="@string/vox_sensitivity" />
                            <SeekBar android:id="@+id/seekVox" style="@style/Slider" android:max="100" />

                            <TextView style="@style/Label" android:text="@string/mic_gain" />
                            <SeekBar android:id="@+id/seekGain" style="@style/Slider" android:max="250" />

                            <TextView style="@style/Label" android:text="@string/mic_level" />
                            <com.mamaddoom.ridetalk.ui.LevelBarView android:id="@+id/micMeter" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="8dp" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                                <Button android:id="@+id/btnMicTest" style="@style/BigButton" android:text="@string/mic_test" />
                            </LinearLayout>
                            <TextView style="@style/Note" android:text="@string/mic_test_note" />
                        </LinearLayout>

                        <TextView android:id="@+id/voiceVolumeLabel" style="@style/Label" android:text="@string/voice_volume" />
                        <SeekBar android:id="@+id/seekVoice" style="@style/Slider" android:max="200" />

                        <Switch android:id="@+id/swRxDenoise" style="@style/BigSwitch" android:text="@string/rx_denoise" />
                        <TextView style="@style/Note" android:layout_marginTop="0dp" android:text="@string/rx_denoise_note" />
                        <Switch android:id="@+id/swEchoGuard" style="@style/BigSwitch" android:text="@string/echo_guard" />
                        <TextView style="@style/Note" android:layout_marginTop="0dp" android:text="@string/echo_guard_note" />

                        <TextView style="@style/Label" android:fontFamily="sans-serif-medium" android:text="@string/gestures_title" />
                        <TextView style="@style/Note" android:lineSpacingMultiplier="1.3" android:text="@string/gestures" />
                    </LinearLayout>

                    <!-- Group & network -->
                    <LinearLayout style="@style/Card">

                        <TextView style="@style/CardTitle" android:text="@string/sec_network" />

                        <TextView style="@style/Note" android:layout_marginTop="0dp" android:text="@string/connection_help" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                            <Button android:id="@+id/btnHotspot" style="@style/BigButton" android:text="@string/open_hotspot" />
                            <Button android:id="@+id/btnWifi" style="@style/BigButton" android:text="@string/open_wifi" />
                        </LinearLayout>

                        <EditText android:id="@+id/editName" style="@style/Field" android:layout_marginTop="12dp" android:hint="@string/name_hint" android:inputType="textPersonName" android:maxLength="24" />

                        <TextView style="@style/Label" android:text="@string/group_code" />
                        <EditText android:id="@+id/editGroup" style="@style/Field" android:hint="@string/group_code_hint" android:inputType="textVisiblePassword" android:maxLength="32" />
                        <TextView style="@style/Note" android:text="@string/group_code_note" />
                    </LinearLayout>

                    <!-- Battery & reliability -->
                    <LinearLayout style="@style/Card">

                        <TextView style="@style/CardTitle" android:text="@string/sec_settings" />

                        <Switch android:id="@+id/swBatterySaver" style="@style/BigSwitch" android:layout_marginTop="0dp" android:text="@string/battery_saver" />
                        <TextView style="@style/Note" android:layout_marginTop="0dp" android:text="@string/battery_saver_note" />

                        <Switch android:id="@+id/swCues" style="@style/BigSwitch" android:text="@string/cues" />
                        <Switch android:id="@+id/swAntiFeedback" style="@style/BigSwitch" android:text="@string/anti_feedback" />
                        <TextView style="@style/Note" android:layout_marginTop="0dp" android:text="@string/anti_feedback_note" />
                        <Switch android:id="@+id/swDriveScreen" style="@style/BigSwitch" android:text="@string/drive_screen_on" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                            <Button android:id="@+id/btnBattery" style="@style/BigButton" android:text="@string/battery_opt" android:textSize="14sp" />
                            <Button android:id="@+id/btnAppSettings" style="@style/BigButton" android:text="@string/app_settings" android:textSize="14sp" />
                        </LinearLayout>

                        <TextView style="@style/Note" android:layout_marginTop="10dp" android:text="@string/guide" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Bottom navigation with a sliding indicator -->
        <FrameLayout
            android:id="@+id/nav"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/nav_bg"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/navIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/nav_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
                    <TextView android:id="@+id/navHomeIcon" style="@style/NavIcon" android:text="🎙" />
                    <TextView android:id="@+id/navHomeLabel" style="@style/NavLabel" android:text="@string/tab_home" />
                </LinearLayout>

                <LinearLayout android:id="@+id/navMusic" style="@style/NavItem">
                    <TextView android:id="@+id/navMusicIcon" style="@style/NavIcon" android:text="🎵" />
                    <TextView android:id="@+id/navMusicLabel" style="@style/NavLabel" android:text="@string/tab_music" />
                </LinearLayout>

                <LinearLayout android:id="@+id/navSettings" style="@style/NavItem">
                    <TextView android:id="@+id/navSettingsIcon" style="@style/NavIcon" android:text="⚙" />
                    <TextView android:id="@+id/navSettingsLabel" style="@style/NavLabel" android:text="@string/tab_settings" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Driving screen: black (cheap on OLED), two huge buttons, nothing else to mis-tap. -->
    <LinearLayout
        android:id="@+id/driveOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView android:id="@+id/driveStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:gravity="center" android:textColor="@color/ok" android:textSize="22sp" />
        <TextView android:id="@+id/driveMusicTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/text_dim" android:textSize="16sp" />

        <Button android:id="@+id/driveTalk" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" android:background="@drawable/button_ptt" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null" android:textAllCaps="false" android:textColor="@color/text" android:textSize="32sp" />
        <Button android:id="@+id/driveMusic" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" android:background="@drawable/button" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null" android:textAllCaps="false" android:textColor="@color/text" android:textSize="32sp" />
        <Button android:id="@+id/driveExit" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="16dp" android:background="@drawable/button" android:stateListAnimator="@null" android:text="@string/drive_exit" android:textAllCaps="false" android:textColor="@color/text_dim" android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
