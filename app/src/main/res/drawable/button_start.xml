<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector android:enterFadeDuration="250" android:exitFadeDuration="250">
            <!-- Running: ink-black "stop", like the helmet. -->
            <item android:state_activated="true">
                <shape><solid android:color="?attr/cText" /><corners android:radius="28dp" /></shape>
            </item>
            <item>
                <shape>
                    <solid android:color="?attr/cAccent" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
