<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector android:enterFadeDuration="250" android:exitFadeDuration="250">
            <item android:state_activated="true">
                <shape><solid android:color="@color/danger_dark" /><stroke android:width="1.5dp" android:color="@color/danger" /><corners android:radius="28dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="@color/ok" /><corners android:radius="28dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
