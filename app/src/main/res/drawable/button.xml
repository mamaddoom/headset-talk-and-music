<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/accent_dark" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:state_enabled="false">
                <shape><solid android:color="@color/surface" /><corners android:radius="16dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="@color/surface2" /><corners android:radius="16dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
