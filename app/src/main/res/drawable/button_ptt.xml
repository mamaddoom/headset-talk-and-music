<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/cRipple">
    <item>
        <selector android:enterFadeDuration="200" android:exitFadeDuration="200">
            <item android:state_activated="true">
                <shape><solid android:color="?attr/cAccent" /><corners android:radius="28dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="?attr/cAccentDark" /><stroke android:width="2dp" android:color="?attr/cAccent" /><corners android:radius="28dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
