    <string name="app_audio_stop">Stop sharing app audio</string>
    <string name="app_audio_note">Play music in any app on this phone (Spotify, YouTube Music, a podcast app, your music player…) and everyone connected hears it. You hear it directly from that app. Android will ask to allow “screen recording” — only the audio is used, nothing on the screen is captured or sent. A few apps block audio sharing; they will stay silent.</string>
    <string name="app_audio_live">● Sending to everyone</string>
    <string name="app_audio_waiting">Waiting… start playing in your music app.</string>
    <string name="app_audio_failed">This phone does not allow capturing app audio.</string>
    <string name="app_audio_unsupported">Sharing app audio needs Android 10 or newer.</string>

    <string name="mode_hifi">🎵 Music quality</string>
    <string name="mode_call">📞 Mic always on</string>
    <string name="mode_hifi_note">Music and voices play in full stereo quality. To talk, tap the big button or your headset button: a beep tells you the mic is live, and after you stop talking it switches back to full quality by itself.</string>
    <string name="mode_call_note">The headset mic is always available, hands-free. Classic Bluetooth only carries the mic in “call” mode (mono, up to 16 kHz), so music sounds like a phone call — the app squeezes the best it can out of it. LE Audio headsets (LC3) and wired headsets keep full quality even here.</string>
    <string name="ptt_tap">TAP TO TALK</string>
    <string name="talk_preparing">Opening mic…</string>
    <string name="talk_live">● Talk now · tap to finish</string>
