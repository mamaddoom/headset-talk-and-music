    <string name="noise_max">maximum</string>
    <string name="noise_note">Stronger settings remove more wind and engine noise; at maximum your voice may sound a bit thinner.</string>
    <string name="battery_saver">Battery saver</string>
    <string name="battery_saver_note">While nobody is connected and nothing is playing, the mic and Bluetooth call link are switched off; they come back automatically when someone connects. After 30 minutes alone the intercom turns itself off.</string>
    <string name="status_standby">Waiting for riders · power saving</string>

