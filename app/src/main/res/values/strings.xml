    <string name="anti_feedback">Anti-feedback (no howling or echo)</string>
    <string name="anti_feedback_note">While someone else talks, your mic is turned down unless you talk clearly yourself. Prevents howling when phones are on speaker near each other. Turn off for fully simultaneous talking.</string>
    <string name="group_code">Group code (optional)</string>
    <string name="group_code_hint">Empty = anyone on this hotspot</string>
    <string name="group_code_note">Everyone in your group enters the same code. Only phones with the same code hear each other, and all audio is encrypted (AES). Applies immediately.</string>

