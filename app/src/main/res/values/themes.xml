<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pink ("girly") is the default; blue ("boyish") is picked on first launch or in settings. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="cBg">@color/pink_bg</item>
        <item name="cSurface">@color/pink_surface</item>
        <item name="cSurface2">@color/pink_surface2</item>
        <item name="cStroke">@color/pink_stroke</item>
        <item name="cText">@color/pink_text</item>
        <item name="cTextDim">@color/pink_text_dim</item>
        <item name="cAccent">@color/pink_accent</item>
        <item name="cAccentMid">@color/pink_accent_mid</item>
        <item name="cAccentDark">@color/pink_accent_dark</item>
        <item name="cRipple">@color/pink_ripple</item>
        <item name="appArt">@drawable/ic_launcher_fg</item>
        <item name="appArtBg">@drawable/ic_launcher_bg</item>
        <item name="android:colorAccent">@color/pink_accent</item>
        <item name="android:colorPrimary">@color/pink_bg</item>
        <item name="android:colorPrimaryDark">@color/pink_bg</item>
        <item name="android:windowBackground">@color/pink_bg</item>
        <item name="android:statusBarColor">@color/pink_bg</item>
        <item name="android:navigationBarColor">@color/pink_surface</item>
        <item name="android:textColorPrimary">@color/pink_text</item>
        <item name="android:textColorSecondary">@color/pink_text_dim</item>
        <item name="android:colorControlActivated">@color/pink_accent</item>
        <item name="android:colorControlHighlight">@color/pink_ripple</item>
        <item name="android:windowAnimationStyle">@style/WindowFade</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/PinkDialog</item>
    </style>

    <style name="PinkDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="cBg">@color/pink_bg</item>
        <item name="cSurface">@color/pink_surface</item>
        <item name="cSurface2">@color/pink_surface2</item>
        <item name="cStroke">@color/pink_stroke</item>
        <item name="cText">@color/pink_text</item>
        <item name="cTextDim">@color/pink_text_dim</item>
        <item name="cAccent">@color/pink_accent</item>
        <item name="cAccentMid">@color/pink_accent_mid</item>
        <item name="cAccentDark">@color/pink_accent_dark</item>
        <item name="cRipple">@color/pink_ripple</item>
        <item name="android:colorAccent">@color/pink_accent</item>
        <item name="android:textColorPrimary">@color/pink_text</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>

    <style name="AppTheme.Blue" parent="AppTheme">
        <item name="cBg">@color/blue_bg</item>
        <item name="cSurface">@color/blue_surface</item>
        <item name="cSurface2">@color/blue_surface2</item>
        <item name="cStroke">@color/blue_stroke</item>
        <item name="cText">@color/blue_text</item>
        <item name="cTextDim">@color/blue_text_dim</item>
        <item name="cAccent">@color/blue_accent</item>
        <item name="cAccentMid">@color/blue_accent_mid</item>
        <item name="cAccentDark">@color/blue_accent_dark</item>
        <item name="cRipple">@color/blue_ripple</item>
        <item name="appArt">@drawable/ic_launcher_blue_fg</item>
        <item name="appArtBg">@drawable/ic_launcher_blue_bg</item>
        <item name="android:colorAccent">@color/blue_accent</item>
        <item name="android:colorPrimary">@color/blue_bg</item>
        <item name="android:colorPrimaryDark">@color/blue_bg</item>
        <item name="android:windowBackground">@color/blue_bg</item>
        <item name="android:statusBarColor">@color/blue_bg</item>
        <item name="android:navigationBarColor">@color/blue_surface</item>
        <item name="android:textColorPrimary">@color/blue_text</item>
        <item name="android:textColorSecondary">@color/blue_text_dim</item>
        <item name="android:colorControlActivated">@color/blue_accent</item>
        <item name="android:colorControlHighlight">@color/blue_ripple</item>
        <item name="android:windowAnimationStyle">@style/WindowFade</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/BlueDialog</item>
    </style>

    <style name="BlueDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="cBg">@color/blue_bg</item>
        <item name="cSurface">@color/blue_surface</item>
        <item name="cSurface2">@color/blue_surface2</item>
        <item name="cStroke">@color/blue_stroke</item>
        <item name="cText">@color/blue_text</item>
        <item name="cTextDim">@color/blue_text_dim</item>
        <item name="cAccent">@color/blue_accent</item>
        <item name="cAccentMid">@color/blue_accent_mid</item>
        <item name="cAccentDark">@color/blue_accent_dark</item>
        <item name="cRipple">@color/blue_ripple</item>
        <item name="android:colorAccent">@color/blue_accent</item>
        <item name="android:textColorPrimary">@color/blue_text</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>

    <style name="WindowFade" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="Page">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbars">none</item>
        <item name="android:overScrollMode">never</item>
    </style>

    <style name="PageColumn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">24dp</item>
        <item name="android:animateLayoutChanges">true</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:animateLayoutChanges">true</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/cTextDim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Note" parent="Body">
        <item name="android:textColor">?attr/cTextDim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Label" parent="Body">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Glove-friendly: 56dp+ tall, large text. -->
    <style name="BigButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/button</item>
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:progressTint">?attr/cAccent</item>
        <item name="android:thumbTint">?attr/cAccent</item>
        <item name="android:progressBackgroundTint">?attr/cStroke</item>
    </style>

    <style name="BigSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textColorHint">?attr/cTextDim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/nav_item</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="NavIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/cTextDim</item>
    </style>
    <!-- Icon + slider rows on the settings page. -->
    <style name="IconRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="RowIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="RowSlider" parent="Slider">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>
</resources>
